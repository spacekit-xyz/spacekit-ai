+        let mut best = f32::INFINITY;
+        let mut best_num = 0.0;
+        for h in [3e-3f32, 1e-3, 3e-4] {
+            set(st, orig + h);
+            let lp = summed_loss(st, e);
+            set(st, orig - h);
+            let lm = summed_loss(st, e);
+            set(st, orig);
+            let num = ((lp - lm) / (2.0 * h as f64)) as f32;
+            let err = (analytic - num).abs() / (1.0 + num.abs());
+            if err < best {
+                best = err;
+                best_num = num;
+            }
+        }
+        (best < 1e-2, best_num)
+    }
