+    fn early_stopper_patience() {
+        let mut es = EarlyStopper::new(2, 0.0);
+        assert!(es.observe(100, 3.0));
+        assert!(!es.observe(200, 3.1));
+        assert!(!es.should_stop());
+        assert!(!es.observe(300, 3.0));
+        assert!(es.should_stop());
+        assert_eq!(es.best_step, 100);
     }
 }
