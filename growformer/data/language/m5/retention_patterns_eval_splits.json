    },
    {
      "phase": 2,
      "domain": "architectural_patterns",
      "train_file": "data/language/m5/train_architectural_patterns.jsonl",
      "post_phase_eval_files": [
        "data/language/m5/eval_design_patterns_holdout.jsonl",
        "data/language/m5/eval_architectural_patterns_holdout.jsonl"
      ]
    }
  ]
}
